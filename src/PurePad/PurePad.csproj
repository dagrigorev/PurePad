<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PurePad</AssemblyName>
    <RootNamespace>PurePad</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>PurePad</Product>
    <AssemblyTitle>PurePad</AssemblyTitle>
    <Version>1.0.0</Version>
    <Company>PurePad</Company>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the window/taskbar can load the full multi-resolution icon at runtime. -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

</Project>
